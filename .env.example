# LLM Provider Configuration
# Supported providers: "groq" (fastest cloud), "ollama" (free/local), or "openai"
LLM_PROVIDER=groq

# Groq Configuration (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
# Alternative models on Groq: GROQ_MODEL=qwen/qwen3.8-27b or GROQ_MODEL=openai/gpt-oss-20b

# Ollama Configuration (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# OpenAI Configuration (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Logging Configuration
LOG_LEVEL=INFO
